# Copy this file to .env and add your own API key. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Set 1 to disable model/provider routes even with a configured key; restart after changes.
BOLPREP_OFFLINE=0
# Optional requested model for recorded-file STT; availability is provider/account dependent.
BOLPREP_STT_MODEL=gpt-transcribe
# Optional localhost demo gate: use a separate 16-256 character password.
# Empty keeps login disabled. Never use your model API key as this password.
BOLPREP_ACCESS_PASSWORD=
